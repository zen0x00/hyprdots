{
  "frame": false,
  "minimizeOnClose": true,
  "closeAppOnCross": false,
  "followSystemTheme": false,
  "customCSSName": "tweaks",
  "customCSSLocation": "{{ env.home }}/.config/teams-for-linux/custom.css",
  "notificationMethod": "electron",
  "notifications.timeoutType": "never",
  "disableNotificationSoundIfNotAvailable": true,
  "download": {
    "enabled": true,
    "notifyOnDownloadComplete": true,
    "showProgressBar": true,
    "showTitlePrefix": false
  },
  "globalShortcuts": [
    "Control+Shift+M",
    "Control+Shift+O",
    "Control+Shift+E"
  ],
  "media": {
    "microphone": {
      "disableAutogain": true
    },
    "video": {
      "menuEnabled": true
    }
  }
}
