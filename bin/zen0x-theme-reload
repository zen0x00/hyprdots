#!/usr/bin/env bash
set -u

status=0
ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"

read_theme_value() {
    local file_path="$1"

    [[ -f "$file_path" ]] || return 1

    awk '
        /^[[:space:]]*(#|;|$)/ { next }
        { print; exit }
    ' "$file_path"
}

get_gtk_theme_name() {
    local current_theme theme_dir gtk_theme_file

    [[ -f "$ROOT/.current-theme" ]] || return 1
    current_theme="$(<"$ROOT/.current-theme")"
    theme_dir="$ROOT/themes/$current_theme"
    gtk_theme_file="$theme_dir/gtk.theme"

    if [[ -f "$gtk_theme_file" ]]; then
        read_theme_value "$gtk_theme_file"
        return
    fi

    printf 'Abyssal-%s\n' "$current_theme"
}

if command -v hyprctl >/dev/null 2>&1; then
    if ! hyprctl reload; then
        echo "Warning: Hyprland reload failed." >&2
        status=1
    fi
else
    echo "Warning: hyprctl not found; skipped Hyprland reload." >&2
    status=1
fi

if command -v pkill >/dev/null 2>&1; then
    pkill -SIGUSR1 kitty 2>/dev/null || true
    pkill -SIGUSR2 waybar 2>/dev/null || true
    pkill swayosd-server 2>/dev/null || true
fi

command -v swayosd-server >/dev/null 2>&1 && swayosd-server &>/dev/null &

command -v swaync-client >/dev/null 2>&1 && swaync-client --reload-css 2>/dev/null || true

if command -v gsettings >/dev/null 2>&1; then
    if ! gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null; then
        echo "Warning: failed to set GTK color scheme." >&2
        status=1
    fi

    if gtk_theme="$(get_gtk_theme_name)"; then
        if ! gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null; then
            echo "Warning: failed to set GTK theme to '$gtk_theme'." >&2
            status=1
        fi
    fi

    if [[ -f "$ROOT/.current-theme" ]]; then
        icon_theme_file="$ROOT/themes/$(<"$ROOT/.current-theme")/icon.theme"
        if icon_theme="$(read_theme_value "$icon_theme_file")"; then
            if ! gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null; then
                echo "Warning: failed to set icon theme to '$icon_theme'." >&2
                status=1
            fi
        fi
    fi
fi

if command -v jq >/dev/null 2>&1; then
    if ! "$ROOT/bin/zen0x-theme-set-vscode"; then
        echo "Warning: VS Code theme sync failed." >&2
        status=1
    fi
fi

if [[ -f "$ROOT/.current-theme" ]]; then
    wallpaper="$ROOT/themes/$(cat "$ROOT/.current-theme")/wallpaper.jpg"
    if [[ -f $wallpaper ]]; then
        wallpaper_target="$HOME/.config/hypr/wallpaper.jpg"
        mkdir -p "$(dirname "$wallpaper_target")"
        cp "$wallpaper" "$wallpaper_target"
        command -v awww >/dev/null 2>&1 && awww img -a "$wallpaper_target" --transition-type any --transition-fps 60 2>/dev/null || true
    fi
fi

command -v pkill >/dev/null 2>&1 && pkill -HUP hyprlock 2>/dev/null || true

for _sock in /run/user/$(id -u)/nvim.*.0; do
    [[ -S "$_sock" ]] && nvim --server "$_sock" --remote-send ':colorscheme zen0x<CR>' 2>/dev/null || true
done
unset _sock

if [ "$status" -eq 0 ]; then
    notify-send "zen0x" "Reloaded theme files and synced VS Code settings."
else
    notify-send -u critical "zen0x" "Theme files generated, but one or more reload steps failed."
fi

exit "$status"
