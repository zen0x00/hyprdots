#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"

CURRENT_THEME_FILE="$ROOT/.current-theme"

if [[ ! -f $CURRENT_THEME_FILE ]]; then
  echo "No current theme set. Run zen0x-theme-menu first." >&2
  exit 1
fi

THEME_SLUG="$(cat "$CURRENT_THEME_FILE")"
VS_CODE_THEME="$ROOT/themes/$THEME_SLUG/vscode.json"

upsert_color_theme() {
  local settings_path="$1"
  local theme_name="$2"

  if grep -q '"workbench.colorTheme"' "$settings_path"; then
    sed -i --follow-symlinks -E \
      "s/(\"workbench.colorTheme\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")/\1$theme_name\2/" \
      "$settings_path"
    return
  fi

  sed -i --follow-symlinks -E \
    "0,/\{/{s/\{/\{\n  \"workbench.colorTheme\": \"$theme_name\",/}" \
    "$settings_path"
}

remove_color_theme() {
  local settings_path="$1"
  sed -i --follow-symlinks -E 's/\"workbench\.colorTheme\"[[:space:]]*:[^,}]*,?//' "$settings_path"
}

set_theme() {
  local editor_cmd="$1"
  local settings_path="$2"
  local theme_name=""
  local extension=""

  command -v "$editor_cmd" >/dev/null 2>&1 || return 0

  mkdir -p "$(dirname "$settings_path")"
  [[ -f $settings_path ]] || printf '{\n}\n' >"$settings_path"

  if [[ ! -f $VS_CODE_THEME ]]; then
    [[ -f $settings_path ]] && remove_color_theme "$settings_path"
    return 0
  fi

  theme_name=$(jq -er '.name' "$VS_CODE_THEME")
  extension=$(jq -r '.extension // empty' "$VS_CODE_THEME")

  upsert_color_theme "$settings_path" "$theme_name"

  if [[ -n $extension ]]; then
    if ! "$editor_cmd" --list-extensions 2>/dev/null | grep -Fxq "$extension"; then
      if ! "$editor_cmd" --install-extension "$extension" >/dev/null 2>&1; then
        echo "Warning: failed to install VS Code extension '$extension' via $editor_cmd." >&2
      fi
    fi
  fi
}

set_theme "code"         "$HOME/.config/Code/User/settings.json"
set_theme "code-insiders" "$HOME/.config/Code - Insiders/User/settings.json"
set_theme "codium"       "$HOME/.config/VSCodium/User/settings.json"
set_theme "cursor"       "$HOME/.config/Cursor/User/settings.json"
